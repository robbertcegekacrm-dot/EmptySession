# Supabase project settings (Project Settings > API). The anon key is public by design;
# all access control is enforced by row level security in the database.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only used by `npm run test:rls`. Never prefix this with VITE_ (that would ship it to the browser).
ORGANIZER_CODE=
